{
  "manifest_version": 3,
  "name": "OpenLink",
  "version": "1.0.0",
  "description": "OpenLink 代理 - 连接 AI 与本地环境",
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.gemini.google.com/*", "*://aistudio.google.com/*", "*://chatgpt.com/*", "*://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.gemini.google.com/*", "*://aistudio.google.com/*", "*://chatgpt.com/*", "*://chat.openai.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "openlink@afumu.dev"
    }
  }
}
